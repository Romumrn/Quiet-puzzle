prototype/audio/*.wav
prototype/audio/1-aube.mp3
prototype/audio/2-derive.mp3

.DS_Store
node_modules/

# Supabase personal access token — full Management API rights on the project.
# This repository is public.
.env
.env.local

# Generated by generator/difficulty-map.mjs — regenerate, do not commit.
difficulty-map.html

# Android app (mobile/) — Capacitor-generated and build output.
# The native project itself (mobile/android/, minus build output) IS tracked:
# it carries manual native edits (immersive mode, manifest, signing config)
# that `npx cap sync` does not regenerate.
mobile/www/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/src/main/assets/public/

# Signing keystore — losing it means losing the ability to update the app on
# the Play Store. Never committed; back it up outside this machine instead.
*.keystore
*.jks
keystore.properties
